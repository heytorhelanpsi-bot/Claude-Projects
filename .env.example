# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# --- Acesso ao SMR ---
SMR_URL=http://smr.deso-se.com.br
SMR_USER=
SMR_PASSWORD=
# Páginas extras a visitar após o login, separadas por vírgula (só se os pontos ficarem em outras telas)
SMR_PAGES=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Um ou mais IDs separados por vírgula (pessoa ou grupo)
TELEGRAM_CHAT_ID=

# --- Regras do R0 Sobrado ---
NIVEL_CRITICO_MIN=1.20
NIVEL_CRITICO_MAX=3.95
SUBIDA_RAPIDA_M=0.20
SUBIDA_RAPIDA_JANELA_MIN=30
AVISAR_CADA_METRO=1
REPETIR_CRITICO_MIN=15

# --- Faixas aceitáveis das vazões (m³/h) ---
# Alerta quando a vazão fica ABAIXO do mínimo. Deixe o MAX vazio para não alertar vazão alta.
R0_R2_VAZAO_MIN=1900
R0_R2_VAZAO_MAX=
R0_R8_VAZAO_MIN=790
R0_R8_VAZAO_MAX=
# Margem (%) para considerar a vazão normalizada e evitar avisos repetidos na borda
VAZAO_HISTERESE_PCT=1

# --- Agendamento ---
INTERVALO_VERIFICACAO_MIN=5
INTERVALO_RELATORIO_MIN=15
DADO_ATRASADO_MIN=60
FALHAS_ANTES_DE_AVISAR=3
FUSO_HORARIO=America/Maceio
